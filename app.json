{
  "package_id": "com.nickustinov.weatherapp",
  "name": "Weather",
  "version": "2.1.1",
  "edition": "202601",
  "description": "Weather forecast for Even G2",
  "tagline": "Current weather and forecasts on your glasses",
  "author": "nickustinov",
  "entrypoint": "index.html",
  "min_app_version": "0.1.0",
  "min_sdk_version": "0.0.9",
  "supported_languages": ["en", "zh", "es", "fr", "de", "ja", "ko", "it"],
  "permissions": [
    {
      "name": "network",
      "desc": "Fetches weather data from API.",
      "whitelist": [
        "https://api.open-meteo.com",
        "https://geocoding-api.open-meteo.com",
        "https://air-quality-api.open-meteo.com",
        "http://www.w3.org",
        "https://react.dev",
        "https://assets.lemonsqueezy.com",
        "https://store.itsyapps.com",
        "https://app.lemonsqueezy.com"
      ]
    }
  ]
}
